# .gitignore para projeto Java / Maven

# Build output
/target/
/out/
/build/

# Compiled class files
*.class

# Packages
*.jar
*.war
*.ear

# Maven specific
/dependency-reduced-pom.xml
/release.properties
/pom.xml.tag
/pom.xml.releaseBackup
/pom.xml.versionsBackup
/buildNumber.properties
/.mvn/timing.properties
# keep the maven wrapper jar committed; ignore user-specific wrapper properties
/.mvn/wrapper/maven-wrapper.properties

# Logs
*.log
logs/
*.log.*

# Test reports
/surefire-reports/
jacoco.exec
coverage/

# IDEs
/.idea/
*.iml
*.iws
/.vscode/

# Eclipse
.metadata/
.classpath
.project
/.settings/

# NetBeans
/nbproject/private/

# OS files
.DS_Store
Thumbs.db

# Environment
.env

# Temporary files
*~
*.swp
*.swo

# Docker
docker-compose.override.yml

# Ignore IntelliJ workspace files that may contain local paths
/.idea/**/workspace.xml
/.idea/**/tasks.xml
/.idea/**/usage.statistics.xml

# Ignore IDE launchers
*.log

